// Prisma schema mirroring the Mongoose models in src/models.
// Collection and field names are mapped so both ORMs read/write the same documents.
// Keep this file in sync when a Mongoose model changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

// ---------- Enums ----------

enum Role {
  admin
  faculty
  student
  staff
}

enum AttendanceCode {
  P
  A
  L
  OD
  LT
}

enum AssessmentStatus {
  draft
  submitted
  verified
  published
}

enum SubmissionStatus {
  submitted
  evaluated
  resubmit
}

enum EventType {
  holiday
  event
  exam
  other
}

enum EventAudience {
  all
  faculty
  student
  staff
}

enum FeeStatus {
  pending
  paid
}

enum Channel {
  inapp
  email
  sms
  push
}

enum AudienceType {
  role
  course
  users
}

enum MessageStatus {
  scheduled
  sent
  failed
}

enum RequestType {
  Bonafide   @map("Bonafide certificate")
  IdCard     @map("ID card")
  Transfer   @map("Transfer certificate")
  Correction @map("Profile correction")
  Leave      @map("Leave request")
  Other
}

enum RequestStatus {
  pending
  approved
  rejected
  completed
}

// ---------- Embedded types ----------

type FileRef {
  name String?
  path String?
  size Int?
}

type AssessmentMark {
  studentId String? @map("student") @db.ObjectId
  marks     Float?
  absent    Boolean @default(false)
}

type AttendanceRecord {
  studentId String         @map("student") @db.ObjectId
  status    AttendanceCode @default(P)
}

type LessonPlanItem {
  id      String?   @map("_id") @db.ObjectId
  unit    String?
  topic   String?
  planned DateTime?
  done    Boolean   @default(false)
}

type EvaluationPart {
  key   String?
  label String?
  max   Float?
  pass  Float?
}

type MessageAudience {
  type     AudienceType @default(role)
  roles    String[]
  courseId String?      @map("course") @db.ObjectId
  userIds  String[]     @map("users") @db.ObjectId
}

type MessageStats {
  recipients Int?
  inapp      Int?
  email      Int?
  sms        Int?
  push       Int?
  failed     Int?
}

type AcademicYear {
  start DateTime?
  end   DateTime?
  label String?
}

type Session {
  name    String?
  start   String?
  end     String?
  isBreak Boolean?
}

// ---------- Models ----------

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String   @unique
  password    String
  role        Role
  phone       String?
  department  String?
  designation String?
  employeeId  String?
  rollNo      String?
  level       String?
  program     String?
  batch       String?
  section     String?
  semester    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coursesTaught        Course[]       @relation("CourseFaculty")
  assessmentsCreated   Assessment[]   @relation("AssessmentCreatedBy")
  assignmentsCreated   Assignment[]   @relation("AssignmentCreatedBy")
  submissions          Submission[]   @relation("SubmissionStudent")
  submissionsEvaluated Submission[]   @relation("SubmissionEvaluatedBy")
  attendanceMarked     Attendance[]   @relation("AttendanceMarkedBy")
  eventsCreated        Event[]        @relation("EventCreatedBy")
  fees                 Fee[]          @relation("FeeStudent")
  messagesSent         Message[]      @relation("MessageSentBy")
  notifications        Notification[] @relation("NotificationUser")
  requests             Request[]      @relation("RequestStudent")
  requestsHandled      Request[]      @relation("RequestHandledBy")

  @@index([role])
  @@index([role, batch, section])
  @@map("users")
}

model Course {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  code       String           @unique
  name       String
  department String?
  level      String?
  program    String?
  batch      String?
  section    String?
  semester   String?
  type       String?          @default("theory")
  lectures   Int?
  tutorials  Int?
  practicals Int?
  credits    Int              @default(3)
  hours      Int?
  evaluation EvaluationPart[]
  passMarks  Float?
  facultyId  String?          @map("faculty") @db.ObjectId
  faculty    User?            @relation("CourseFaculty", fields: [facultyId], references: [id])
  // Enrolled student ids. Kept as a plain id list (not a Prisma m-n relation) because
  // Mongoose does not store the reverse list on users.
  studentIds String[]         @map("students") @db.ObjectId
  lessonPlan LessonPlanItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  assessments Assessment[]
  assignments Assignment[]
  attendance  Attendance[]

  @@index([facultyId])
  @@index([studentIds])
  @@map("courses")
}

model Attendance {
  id         String             @id @default(auto()) @map("_id") @db.ObjectId
  courseId   String             @map("course") @db.ObjectId
  course     Course             @relation(fields: [courseId], references: [id])
  date       DateTime
  period     Int                @default(1)
  topic      String?
  records    AttendanceRecord[]
  markedById String?            @map("markedBy") @db.ObjectId
  markedBy   User?              @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([courseId, date, period])
  @@map("attendances")
}

model Assessment {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  courseId    String           @map("course") @db.ObjectId
  course      Course           @relation(fields: [courseId], references: [id])
  name        String
  maxMarks    Float
  passMarks   Float?
  component   String?
  date        DateTime?
  marks       AssessmentMark[]
  status      AssessmentStatus @default(draft)
  createdById String?          @map("createdBy") @db.ObjectId
  createdBy   User?            @relation("AssessmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([courseId])
  @@map("assessments")
}

model Assignment {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  courseId     String    @map("course") @db.ObjectId
  course       Course    @relation(fields: [courseId], references: [id])
  title        String
  description  String?
  topic        String?
  publishDate  DateTime  @default(now())
  dueDate      DateTime
  extendedDate DateTime?
  maxMarks     Float     @default(10)
  hideIdentity Boolean   @default(false)
  files        FileRef[]
  createdById  String?   @map("createdBy") @db.ObjectId
  createdBy    User?     @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  submissions Submission[]

  @@index([courseId])
  @@map("assignments")
}

model Submission {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  assignmentId  String           @map("assignment") @db.ObjectId
  assignment    Assignment       @relation(fields: [assignmentId], references: [id])
  studentId     String           @map("student") @db.ObjectId
  student       User             @relation("SubmissionStudent", fields: [studentId], references: [id])
  text          String?
  files         FileRef[]
  submittedAt   DateTime         @default(now())
  late          Boolean          @default(false)
  attempts      Int              @default(1)
  status        SubmissionStatus @default(submitted)
  marks         Float?
  remarks       String?
  evaluatedById String?          @map("evaluatedBy") @db.ObjectId
  evaluatedBy   User?            @relation("SubmissionEvaluatedBy", fields: [evaluatedById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

model Event {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  type        EventType     @default(event)
  start       DateTime
  end         DateTime
  audience    EventAudience @default(all)
  createdById String?       @map("createdBy") @db.ObjectId
  createdBy   User?         @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([start])
  @@map("events")
}

model Fee {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  studentId String    @map("student") @db.ObjectId
  student   User      @relation("FeeStudent", fields: [studentId], references: [id])
  title     String
  term      String?
  amount    Float
  dueDate   DateTime?
  status    FeeStatus @default(pending)
  paidAt    DateTime?
  mode      String?
  txnId     String?
  receiptNo String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([studentId])
  @@index([status])
  @@map("fees")
}

model Template {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  event         String?
  channel       Channel  @default(inapp)
  subject       String?
  body          String
  dltTemplateId String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@map("templates")
}

model Message {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  subject     String
  body        String
  channels    Channel[]
  audience    MessageAudience?
  templateId  String?          @map("template") @db.ObjectId
  template    Template?        @relation(fields: [templateId], references: [id])
  scheduledAt DateTime?
  status      MessageStatus    @default(scheduled)
  sentAt      DateTime?
  stats       MessageStats?
  error       String?
  sentById    String?          @map("sentBy") @db.ObjectId
  sentBy      User?            @relation("MessageSentBy", fields: [sentById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@map("messages")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user") @db.ObjectId
  user      User     @relation("NotificationUser", fields: [userId], references: [id])
  fromId    String?  @map("from") @db.ObjectId
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}

model Request {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String        @map("student") @db.ObjectId
  student     User          @relation("RequestStudent", fields: [studentId], references: [id])
  type        RequestType
  details     String?
  status      RequestStatus @default(pending)
  remarks     String?
  handledById String?       @map("handledBy") @db.ObjectId
  handledBy   User?         @relation("RequestHandledBy", fields: [handledById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([studentId])
  @@index([status])
  @@map("requests")
}

model Settings {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  key             String        @unique @default("main")
  institutionName String?
  academicYear    AcademicYear?
  weeklyOffs      Int[]
  sessions        Session[]
  levels          String[]
  departments     String[]
  programs        String[]
  batches         String[]
  sections        String[]
  semesters       String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("settings")
}
