PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/vidyqora
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173
INSTITUTION_NAME=Vidyqora Institute

# Optional: email (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vidyqora <no-reply@example.com>"

# Optional: SMS gateway (POST JSON {to, message}); blank = log to console
SMS_API_URL=
SMS_API_KEY=

# Login accounts created by `npm run seed` (one per role)
ADMIN_EMAIL=admin@vidyqora.edu
ADMIN_PASSWORD=Admin@123
OFFICE_EMAIL=staff@vidyqora.edu
OFFICE_PASSWORD=Staff@123
FACULTY_EMAIL=meera@vidyqora.edu
FACULTY_PASSWORD=Faculty@123
STUDENT_EMAIL=student@vidyqora.edu
STUDENT_PASSWORD=Student@123
